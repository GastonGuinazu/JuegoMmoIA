# Copiá a `.env` (no commitear). Valores en Supabase → Settings → Database.

# Pooler transaccional (Prisma Client / app en runtime)
DATABASE_URL="postgresql://postgres.PROJECT_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# `migrate` / `db push`: preferí Session pooler :5432 con usuario `postgres.PROJECT_REF`.
# Si tu red alcanza el host `db.*.supabase.co`, podés usar la URL "Direct" ahí como DIRECT_URL.
DIRECT_URL="postgresql://postgres.PROJECT_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
